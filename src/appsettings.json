{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/",
    "StoryIdsTtl": "00:05:00",
    "ItemTtl": "00:05:00",
    "Parallelism": {
      "MaxDegreeOfParallelism": 10
    },
    "RateLimiting": {
      "PermitLimit": 10,
      "Window": "00:00:10",
      "QueueLimit": 2
    }
  }
}
